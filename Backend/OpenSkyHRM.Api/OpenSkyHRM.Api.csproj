<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\OpenSkyHRM.Application\OpenSkyHRM.Application.csproj" />
    <ProjectReference Include="..\OpenSkyHRM.Persistence\OpenSkyHRM.Persistence.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AWSSDK.S3" Version="3.7.415.28" />
    <PackageReference Include="ClosedXML" Version="0.105.0" />
    <PackageReference Include="Hangfire.AspNetCore" Version="1.8.23" />
    <PackageReference Include="Hangfire.Core" Version="1.8.23" />
    <PackageReference Include="Hangfire.PostgreSql" Version="1.21.1" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.*">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Npgsql" Version="8.0.*" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.1.5" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>93e97f3f-42ae-4d3a-9d1e-303b8fdb8708</UserSecretsId>
  </PropertyGroup>

  <!-- Example and dev settings stay in source for provisioning; never copy to IIS publish output. -->
  <ItemGroup>
    <Content Update="appsettings.Development.json" CopyToPublishDirectory="Never" />
    <Content Update="appsettings.Local.example.json" CopyToPublishDirectory="Never" />
    <Content Update="appsettings.Email.example.json" CopyToPublishDirectory="Never" />
    <Content Update="appsettings.FileStorage.example.json" CopyToPublishDirectory="Never" />
    <Content Update="appsettings.Production.*.example.json" CopyToPublishDirectory="Never" />
  </ItemGroup>

</Project>
