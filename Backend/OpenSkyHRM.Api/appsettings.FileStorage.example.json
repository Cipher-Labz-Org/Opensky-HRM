{
  "FileStorage": {
    "Provider": "S3",
    "BucketName": "openskylabz",
    "KeyPrefix": "Files",
    "RootFolder": "HRM",
    "CompanyFolder": "your-company-code",
    "Region": "ap-southeast-1",
    "AccessKeyId": "YOUR_AWS_ACCESS_KEY_ID",
    "SecretAccessKey": "YOUR_AWS_SECRET_ACCESS_KEY"
  },
  "_folderLayout": {
    "description": "Each company gets these subfolders under s3://openskylabz/Files/HRM/{CompanyFolder}/",
    "folders": [
      "Images/ — employee profile photos",
      "Attachments/ — employee document attachments",
      "Branding/ — company logo",
      "Immigration/ — immigration documents",
      "Leave/Certificates/ — medical certificates",
      "Recruitment/Candidates/ — candidate resumes",
      "Recruitment/Offers/ — offer letters",
      "Recruitment/Requisitions/ — job requisition PDFs"
    ]
  }
}
