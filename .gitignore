# This .gitignore file was automatically created by Microsoft(R) Visual Studio.
################################################################################

/Backend/.vs
/.vs
/Frontend/.next
/Frontend/node_modules
/Frontend/.dist
/Frontend/.vercel

# Build outputs
**/bin/
**/obj/

# Accidental local publish copies under Backend (do not commit)
Backend/_buildtmp*/
Backend/_apicheck*/
Backend/_persistencecheck*/
Backend/_publish-test/
Backend/_publish-release/
Backend/.tmp-api-build/

# Local data-protection keys, uploads, and debug artifacts
*.log
Backend/keys/
Backend/OpenSkyHRM.Api/keys/
Backend/OpenSkyHRM.Api/wwwroot/uploads/
Frontend/.pdf-debug/
Mobile/builds/
**/TestResults/
**/coverage/

# IDE and user-specific files
*.user
*.rsuser
*.suo
*.userosscache

# Coverage artifacts
*.coverage
*.coveragexml

# Local SMTP / secrets (copy from appsettings.Local.example.json)
Backend/OpenSkyHRM.Api/appsettings.Local.json
Backend/OpenSkyHRM.Api/appsettings.S3.json

.vercel

# Never ship local Next env to Vercel (localhost API_URL breaks production builds).
Frontend/.env.local
Frontend/.env.development.local
Frontend/.env.production.local
