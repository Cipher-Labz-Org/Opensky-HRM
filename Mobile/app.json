{
  "expo": {
    "name": "OpenSky HRM",
    "slug": "opensky-hrm",
    "scheme": "openskyhrm",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#2e7bbf"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.openskyhrm.mobile"
    },
    "android": {
      "package": "com.openskyhrm.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#2e7bbf",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-camera",
      "expo-location",
      "expo-splash-screen"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9e322a91-a9d5-426e-8425-99ef08efb130"
      }
    },
    "owner": "kasunsameera96"
  }
}
