# Production API (uncomment to use)
# NEXT_PUBLIC_API_URL=https://OpenSkyhrm.openskylabz.com

# Browser calls the API directly — use 127.0.0.1 on Windows to avoid IPv6 localhost issues.
NEXT_PUBLIC_API_URL=http://127.0.0.1:5000

# Server-side only (Next.js Route Handlers e.g. /api/auth/login). Same host as the API.
API_URL=http://127.0.0.1:5000
