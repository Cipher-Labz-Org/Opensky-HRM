# Local API — omit NEXT_PUBLIC_API_URL so the browser uses same-origin `/hrm-backend` (see next.config.js rewrites).
# NEXT_PUBLIC_API_URL=http://127.0.0.1:5000

# Server-side only (Next rewrites + /api/auth/login). Must match Kestrel (http profile: port 5000).
API_URL=http://127.0.0.1:5000

# --- Multi-tenant local overrides ---
# Routes mbkh.openskyhrm.com (in your hosts file) to the local backend instead of production.
# Add 127.0.0.1 mbkh.openskyhrm.com to C:\Windows\System32\drivers\etc\hosts to use this.
NEXT_PUBLIC_MBKH_API_URL=http://127.0.0.1:5000

# Routes gamma.openskyhrm.com (in your hosts file) to the local backend instead of production.
# Add 127.0.0.1 gamma.openskyhrm.com to C:\Windows\System32\drivers\etc\hosts to use this.
# NEXT_PUBLIC_GAMMA_API_URL=http://127.0.0.1:5000
