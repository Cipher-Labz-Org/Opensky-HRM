# API base URL (must be reachable from the browser). Omit in local dev to use same-origin `/hrm-backend`
# (Next.js rewrites to Kestrel — see next.config.js). After changing env, restart `npm run dev`.
# NEXT_PUBLIC_API_URL=http://localhost:5000

# Force direct browser→API URL in dev instead of `/hrm-backend` proxy (optional).
# NEXT_PUBLIC_API_DEV_PROXY=0

# Production example:
# NEXT_PUBLIC_API_URL=https://openskyhrm.openskylabz.com

# Server-side proxy to the API (login route, Next rewrites). Omit to fall back to NEXT_PUBLIC_API_URL then localhost:5000.
# API_URL=http://localhost:5000
