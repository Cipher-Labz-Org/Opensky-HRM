# Local API — omit NEXT_PUBLIC_API_URL in .env.local to use same-origin `/hrm-backend` (see next.config.js).
# API_URL=http://127.0.0.1:5000

# --- Multi-tenant (production URLs in config/tenant-backends.json) ---
# Local overrides when testing with hosts file (127.0.0.1 mbkh.openskyhrm.com):
# NEXT_PUBLIC_MBKH_API_URL=http://127.0.0.1:5000
# NEXT_PUBLIC_GAMMA_API_URL=http://127.0.0.1:5000

# Legacy single-backend Vercel deploy (optional):
# NEXT_PUBLIC_API_URL=https://gammabackend.openskyhrm.com
# API_URL=https://gammabackend.openskyhrm.com
