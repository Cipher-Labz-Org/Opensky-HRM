# Local API — omit NEXT_PUBLIC_API_URL in .env.local to use same-origin `/hrm-backend` (see next.config.js).
# NEXT_PUBLIC_API_URL=http://127.0.0.1:5000
# API_URL=http://127.0.0.1:5000

# Force direct browser→API URL in dev instead of `/hrm-backend` proxy (optional).
# NEXT_PUBLIC_API_DEV_PROXY=0

# Production / Gamma: set BOTH on the frontend host (Vercel), then redeploy.
# NEXT_PUBLIC_API_URL=https://gammabackend.openskyhrm.com
# API_URL=https://gammabackend.openskyhrm.com
# Browser uses same-origin /api/* and /uploads/* (proxied) — no CORS.

# Other production example:
# NEXT_PUBLIC_API_URL=https://openskyhrm.openskylabz.com
# API_URL=https://openskyhrm.openskylabz.com
