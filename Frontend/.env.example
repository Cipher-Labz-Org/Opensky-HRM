# Local API (browser calls backend directly). Prefer 127.0.0.1 on Windows.
# NEXT_PUBLIC_API_URL=http://127.0.0.1:5000
# API_URL=http://127.0.0.1:5000

# Gamma / production: set BOTH on the frontend host (Vercel), then redeploy.
# NEXT_PUBLIC_API_URL=https://gammabackend.openskyhrm.com
# API_URL=https://gammabackend.openskyhrm.com
# Browser uses same-origin /api/* and /uploads/* (proxied via next.config rewrites) — no CORS.
