# API base URL (must be reachable from the browser). Prefer 127.0.0.1 on Windows for local dev.
# NEXT_PUBLIC_API_URL=http://127.0.0.1:5000
# After changing this file, restart `npm run dev`. The API must list your Next origin in Cors:Origins (Development merges ports 3000–3010 automatically).

# Production example:
# NEXT_PUBLIC_API_URL=https://openskyhrm.openskylabz.com

# Server-side proxy to the API (login route, etc.). Omit to fall back to NEXT_PUBLIC_API_URL then :5000.
# API_URL=http://127.0.0.1:5000
