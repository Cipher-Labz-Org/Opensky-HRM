# Local API (browser calls backend directly). Prefer 127.0.0.1 on Windows.
# NEXT_PUBLIC_API_URL=http://127.0.0.1:5000
# API_URL=http://127.0.0.1:5000

# Vercel / production: set BOTH in Project → Settings → Environment Variables, then redeploy.
# NEXT_PUBLIC_API_URL=https://cipherlabzbackend.openskyhrm.com
# API_URL=https://cipherlabzbackend.openskyhrm.com
# On Vercel the browser uses same-origin /api/* (proxied via next.config rewrites) to avoid CORS.
